##
# Default server
##
server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;
    index index.html index.htm index.nginx-debian.html;
    server_name aitrade.sgdev.ro;

    location / {
        proxy_pass http://127.0.0.1:3010;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}

# ================================
# NEXUS (nexus.sgdev.ro)
# ================================
server {
    if ($host = nexus.sgdev.ro) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name nexus.sgdev.ro;
    return 404;
}

server {
    server_name nexus.sgdev.ro;

    location / {
        proxy_pass http://127.0.0.1:3015;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }

    listen [::]:443 ssl;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/nexus.sgdev.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexus.sgdev.ro/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# ================================
# CHESS (chess.sgdev.ro)  ? NOU, CORECT
# ================================

# --- REDIRECT HTTP -> HTTPS pt chess.sgdev.ro ---
server {
    if ($host = chess.sgdev.ro) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    listen [::]:80;
    server_name chess.sgdev.ro;
    return 404;
}

# --- Blocul HTTPS 443 pt chess (CEA MAI IMPORTANTA!) ---
server {
    listen 443 ssl http2;
    listen [::]:443 ssl;
    server_name chess.sgdev.ro;

    ssl_certificate     /etc/letsencrypt/live/chess.sgdev.ro/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chess.sgdev.ro/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    client_max_body_size 10m;

    # ? SOCKET.IO (WebSocket) ? port 3021
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3021;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout  36000s;
        proxy_send_timeout  36000s;
        proxy_buffering off;
    }

    # ? Next.js Frontend + API routes ? port 3022
    location / {
        proxy_pass http://127.0.0.1:3022;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # (op?ional, recomandat) static cache Next _next/static
    location /_next/static/ {
        alias /var/www/chess/.next/static/;
        expires 365d;
        access_log off;
        add_header Cache-Control "public, immutable";
    }
}